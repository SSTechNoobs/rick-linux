#!/usr/bin/env python3

from pathlib import Path
import tomllib

theme = Path.home() / ".config/aether/theme/colors.toml"

# Ricks Hyprland fallbacks if Aether is unavailable.
colors = {
    "background": "#041E42",
    "foreground": "#FFFFFF",
    "accent": "#003594",
    "muted": "#869397",
    "lighter_bg": "#0C2340",
    "bright_fg": "#DDF8FF",
}

try:
    with theme.open("rb") as f:
        data = tomllib.load(f)

    for key in colors:
        value = data.get(key)
        if isinstance(value, str) and value.startswith("#"):
            colors[key] = value

except Exception:
    pass

print("|".join([
    colors["background"],
    colors["foreground"],
    colors["accent"],
    colors["muted"],
    colors["lighter_bg"],
    colors["bright_fg"],
]))
