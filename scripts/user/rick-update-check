#!/usr/bin/env bash
set -u

LOCK="/tmp/ricks-hyprland-auto-update.lock"
STATE_DIR="$HOME/.local/state/ricks-hyprland"
LOG="$STATE_DIR/auto-update.log"
PACMAN_LOG="/var/log/pacman.log"

mkdir -p "$STATE_DIR"

exec 9>"$LOCK"
flock -n 9 || exit 0

repo_updates="$(checkupdates --nocolor 2>/dev/null || true)"
aur_updates="$(yay -Qua --nocolor 2>/dev/null || true)"

repo_count="$(printf '%s\n' "$repo_updates" | sed '/^$/d' | wc -l)"
aur_count="$(printf '%s\n' "$aur_updates" | sed '/^$/d' | wc -l)"
total=$((repo_count + aur_count))

if (( total == 0 )); then
    exit 0
fi

before_lines=0
if [[ -f "$PACMAN_LOG" ]]; then
    before_lines="$(wc -l < "$PACMAN_LOG")"
fi

{
    echo
    echo "========================================"
    echo "Ricks Hyprland automatic update"
    date
    echo "Official updates: $repo_count"
    echo "AUR updates:      $aur_count"
    echo "========================================"
} >> "$LOG"

if yay -Syu \
    --noconfirm \
    --answerclean None \
    --answerdiff None \
    >> "$LOG" 2>&1
then
    new_lines="$(
        tail -n "+$((before_lines + 1))" "$PACMAN_LOG" 2>/dev/null || true
    )"

    changed="$(
        printf '%s\n' "$new_lines" |
        grep -E '\[ALPM\] (upgraded|installed|downgraded) ' |
        sed -E 's/^.*\[ALPM\] (upgraded|installed|downgraded) ([^ ]+) \((.*)\)$/\2  \3/' |
        head -12
    )"

    changed_count="$(
        printf '%s\n' "$new_lines" |
        grep -Ec '\[ALPM\] (upgraded|installed|downgraded) ' || true
    )"

    if [[ -z "$changed" ]]; then
        changed="Updates completed successfully."
    fi

    body="Installed $changed_count package update(s).

$changed"

    if (( changed_count > 12 )); then
        body="$body

...and $((changed_count - 12)) more"
    fi

    notify-send \
        -a "Ricks Hyprland" \
        -u normal \
        -i system-software-update \
        "Ricks Hyprland Updated" \
        "$body"
else
    notify-send \
        -a "Ricks Hyprland" \
        -u critical \
        -i dialog-error \
        "Ricks Hyprland Update Failed" \
        "Automatic updates did not finish successfully.

Log:
$LOG"

    exit 1
fi
