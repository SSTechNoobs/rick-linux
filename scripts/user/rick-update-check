#!/usr/bin/env bash
set -u

LOCK="/tmp/ricks-hyprland-auto-update.lock"
STATE_DIR="$HOME/.local/state/ricks-hyprland"
LOG="$STATE_DIR/update-check.log"

mkdir -p "$STATE_DIR"

exec 9>"$LOCK"
flock -n 9 || exit 0

printf '\n=== %s Automatic update started ===\n' \
    "$(date --iso-8601=seconds)" >> "$LOG"

if /usr/bin/yay -Syu \
    --noconfirm \
    --answerclean None \
    --answerdiff None \
    >> "$LOG" 2>&1
then
    printf '=== %s Automatic update completed successfully ===\n' \
        "$(date --iso-8601=seconds)" >> "$LOG"

    notify-send \
        -a "Ricks Hyprland" \
        -u normal \
        -t 300000 \
        -i system-software-update \
        "Automatic Updates Complete" \
        "Arch and AUR updates installed successfully."
else
    rc=$?

    printf '=== %s Automatic update FAILED with exit code %s ===\n' \
        "$(date --iso-8601=seconds)" "$rc" >> "$LOG"

    notify-send \
        -a "Ricks Hyprland" \
        -u critical \
        -i dialog-warning \
        "Automatic Update Failed" \
        "See $LOG for details."

    exit "$rc"
fi
