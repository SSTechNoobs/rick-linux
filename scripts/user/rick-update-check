#!/usr/bin/env bash
set -u

LOCK="/tmp/ricks-hyprland-auto-update.lock"
STATE_DIR="$HOME/.local/state/ricks-hyprland"
LOG="$STATE_DIR/update-check.log"

mkdir -p "$STATE_DIR"

exec 9>"$LOCK"
flock -n 9 || exit 0

# Check official Arch updates without installing anything.
updates="$(checkupdates --nocolor 2>>"$LOG")"
status=$?

case "$status" in
    0)
        count="$(printf '%s\n' "$updates" | grep -c . || true)"
        ;;
    2)
        printf '%s: No updates available.\n' "$(date)" >> "$LOG"
        exit 0
        ;;
    *)
        printf '%s: Update check failed (exit %s).\n' \
            "$(date)" "$status" >> "$LOG"
        notify-send \
            -a "Ricks Hyprland" \
            -u normal \
            -i dialog-warning \
            "Update Check Failed" \
            "Could not check Arch updates. See $LOG"
        exit 1
        ;;
esac

if (( count == 0 )); then
    exit 0
fi

printf '%s: %s updates available. Nothing installed.\n' \
    "$(date)" "$count" >> "$LOG"

body="$(printf 'Official Arch updates: %s\n\nClick the taskbar update icon to install manually.\nAUR updates are checked by the taskbar.' "$count")"

notify-send \
    -a "Ricks Hyprland" \
    -u normal \
    -t 300000 \
    -i system-software-update \
    "Ricks Hyprland Updates Available" \
    "$body"
