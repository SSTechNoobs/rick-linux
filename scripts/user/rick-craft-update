#!/usr/bin/env python3
import hashlib
import json
import os
import re
import shutil
import tempfile
import urllib.request
from pathlib import Path

app = Path.home() / "Applications/craft-anything.AppImage"
api = "https://api.github.com/repos/storytold/craft-anything/releases/latest"

def request(url):
    return urllib.request.urlopen(
        urllib.request.Request(
            url, headers={"User-Agent": "Ricks-Hyprland-Updater"}
        ),
        timeout=60
    )

def sha256(path):
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

def main():
    with request(api) as r:
        release = json.load(r)

    version = release["tag_name"]
    if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+", version):
        raise ValueError("Unexpected release version")

    name = f"craft-anything-{version[1:]}-linux-x86_64.AppImage"
    asset = next(a for a in release["assets"] if a["name"] == name)

    expected = asset.get("digest", "")
    if not re.fullmatch(r"sha256:[a-fA-F0-9]{64}", expected):
        raise ValueError("Missing SHA256 verification")

    expected = expected.split(":", 1)[1].lower()

    if app.exists() and sha256(app) == expected:
        print(f"Craft Anything {version}: already up to date.")
        return

    url = asset["browser_download_url"]
    if not url.startswith(
        "https://github.com/storytold/craft-anything/releases/download/"
    ):
        raise ValueError("Unexpected download URL")

    app.parent.mkdir(parents=True, exist_ok=True)

    fd, tmp = tempfile.mkstemp(
        prefix=".craft-update-", dir=app.parent
    )
    os.close(fd)

    try:
        print(f"Downloading Craft Anything {version}...")
        with request(url) as source, open(tmp, "wb") as target:
            shutil.copyfileobj(source, target)

        if os.path.getsize(tmp) != asset["size"]:
            raise ValueError("Download size mismatch")

        if sha256(Path(tmp)) != expected:
            raise ValueError("SHA256 verification failed")

        os.chmod(tmp, 0o755)

        if app.exists():
            shutil.copy2(app, app.with_suffix(".AppImage.previous"))

        os.replace(tmp, app)
        print(f"Craft Anything updated successfully to {version}.")

    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

if __name__ == "__main__":
    main()
