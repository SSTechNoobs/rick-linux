#!/usr/bin/env bash

# TCL Roku TV
curl -fsS -d '' \
  http://192.168.6.238:8060/keypress/PowerOff \
  >/dev/null 2>&1 || true

# Find the LG monitor's current DDC/I2C bus automatically.
LG_I2C="$(basename "$(readlink -f /sys/class/drm/card*-HDMI-A-1/ddc 2>/dev/null | head -n1)")"
LG_BUS="${LG_I2C#i2c-}"

if [[ "$LG_BUS" =~ ^[0-9]+$ ]]; then
    ddcutil --bus "$LG_BUS" setvcp D6 04 \
      >/dev/null 2>&1 || true
fi
