#!/usr/bin/env bash

screen_was_ready=0

restart_bar() {
    pkill -x qs 2>/dev/null || true
    sleep 1

    nohup qs -c rick \
        >/tmp/rick-quickshell.log 2>&1 &
}

while sleep 2; do
    monitors="$(hyprctl monitors 2>/dev/null)"

    if grep -q '^Monitor ' <<< "$monitors" &&
       grep -q 'dpmsStatus: 1' <<< "$monitors"; then

        # TV/output has just returned.
        if [[ "$screen_was_ready" -eq 0 ]]; then
            sleep 2
            restart_bar
            screen_was_ready=1
            continue
        fi

        # Quickshell may still be running while its bar layer is gone.
        if ! hyprctl layers 2>/dev/null |
             grep -q 'namespace: quickshell'; then
            restart_bar
        fi

        # Quickshell actually stopped.
        if ! pgrep -x qs >/dev/null; then
            restart_bar
        fi
    else
        screen_was_ready=0
    fi
done
