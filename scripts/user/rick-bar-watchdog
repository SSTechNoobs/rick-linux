#!/usr/bin/env bash

monitor_was_gone=0

restart_bar() {
    pkill -x qs 2>/dev/null || true
    sleep 1
    nohup qs -c rick >/tmp/rick-quickshell.log 2>&1 &
}

while sleep 2; do
    if hyprctl monitors 2>/dev/null | grep -q '^Monitor '; then
        if [[ "$monitor_was_gone" -eq 1 ]]; then
            sleep 2
            restart_bar
            monitor_was_gone=0
        elif ! pgrep -x qs >/dev/null; then
            restart_bar
        fi
    else
        monitor_was_gone=1
    fi
done
