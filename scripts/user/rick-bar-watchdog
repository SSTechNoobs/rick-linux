#!/usr/bin/env bash

initialized=0
screen_was_ready=0

restart_bar() {
    pkill -x qs 2>/dev/null || true
    sleep 1

    nohup qs -c rick \
        >/tmp/rick-quickshell.log 2>&1 &
}

while sleep 2; do
    monitors="$(hyprctl monitors 2>/dev/null)"

    if grep -q '^Monitor ' <<< "$monitors" &&
       grep -q 'dpmsStatus: 1' <<< "$monitors"; then

        # First healthy startup:
        # do not kill/restart an already working Quickshell bar.
        if [[ "$initialized" -eq 0 ]]; then
            initialized=1
            screen_was_ready=1

            if ! pgrep -x qs >/dev/null ||
               ! hyprctl layers 2>/dev/null |
                   grep -q 'namespace: quickshell'; then
                restart_bar
            fi

            continue
        fi

        # TV/display actually went away and has now returned.
        if [[ "$screen_was_ready" -eq 0 ]]; then
            sleep 2
            restart_bar
            screen_was_ready=1
            continue
        fi

        # Recover if Quickshell or its layer disappears later.
        if ! pgrep -x qs >/dev/null ||
           ! hyprctl layers 2>/dev/null |
               grep -q 'namespace: quickshell'; then
            restart_bar
        fi

    else
        if [[ "$initialized" -eq 1 ]]; then
            screen_was_ready=0
        fi
    fi
done
