#!/usr/bin/env bash

PERMANENT="$HOME/Pictures/RicksLinuxWallpaper/wallpaper.png"
THEME="$HOME/.config/aether/theme"
POINTER="$THEME/ricks-wallpaper-wallpaper.txt"

WALLPAPER=""

# Ricks Linux permanent wallpaper always wins.
if [[ -f "$PERMANENT" ]]; then
    WALLPAPER="$PERMANENT"
elif [[ -s "$POINTER" ]]; then
    candidate="$(head -n1 "$POINTER")"
    [[ -f "$candidate" ]] && WALLPAPER="$candidate"
fi

if [[ -z "$WALLPAPER" || ! -f "$WALLPAPER" ]]; then
    WALLPAPER="$(find "$THEME/backgrounds" \
        -maxdepth 1 -type f -print -quit 2>/dev/null)"
fi

[[ -n "$WALLPAPER" && -f "$WALLPAPER" ]] || exit 0

pkill -x swaybg 2>/dev/null || true
sleep 0.2

nohup swaybg \
    -i "$WALLPAPER" \
    -m fill \
    >/tmp/rick-swaybg.log 2>&1 &
