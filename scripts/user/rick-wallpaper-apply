#!/usr/bin/env bash

PERMANENT="$HOME/Pictures/RicksLinuxWallpaper/wallpaper.png"
THEME="$HOME/.config/aether/theme"
AETHER_WALLPAPER="$THEME/backgrounds/wallpaper.png"

WALLPAPER=""

# Current Aether theme wallpaper wins.
if [[ -f "$AETHER_WALLPAPER" ]]; then
    WALLPAPER="$AETHER_WALLPAPER"

# Fall back to the permanent Ricks Hyprland wallpaper.
elif [[ -f "$PERMANENT" ]]; then
    WALLPAPER="$PERMANENT"
fi

[[ -n "$WALLPAPER" && -f "$WALLPAPER" ]] || exit 0

pkill -x swaybg 2>/dev/null || true
sleep 0.2

nohup swaybg \
    -i "$WALLPAPER" \
    -m fill \
    >/tmp/rick-swaybg.log 2>&1 &
