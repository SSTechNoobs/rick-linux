#!/usr/bin/env bash
set -u

QUEUE="Brother_HL_L2395DW"
URI="ipp://Brother%20HL-L2395DW%20series._ipp._tcp.local/"

# Already configured: make sure it remains the default printer.
if lpstat -p "$QUEUE" >/dev/null 2>&1; then
    lpadmin -d "$QUEUE" >/dev/null 2>&1 || true
    exit 0
fi

# Give networking, Avahi, CUPS, and the printer time to become available.
for attempt in {1..12}; do
    if lpinfo -v 2>/dev/null | grep -qi 'HL-L2395DW'; then
        if lpadmin \
            -p "$QUEUE" \
            -E \
            -v "$URI" \
            -m everywhere
        then
            lpadmin -d "$QUEUE" >/dev/null 2>&1 || true
            exit 0
        fi

        # Printer was visible but setup failed. Do not loop forever.
        exit 0
    fi

    sleep 10
done

# Printer is not on this computer's network.
# This is normal on universal Ricks Hyprland installations.
exit 0
