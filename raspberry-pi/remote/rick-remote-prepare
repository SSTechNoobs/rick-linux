#!/usr/bin/env bash
set -Eeuo pipefail

DIR="$HOME/.config/rick-remote"
CERT="$DIR/novnc-cert.pem"
KEY="$DIR/novnc-key.pem"

mkdir -p "$DIR"
chmod 700 "$DIR"

# Never replace a trusted certificate already installed.
if [[ -s "$CERT" && -s "$KEY" ]]; then
    exit 0
fi

HOST="$(cat /etc/hostname)"
IP=""

for _ in {1..20}; do
    IP="$(
        ip -4 route get 1.1.1.1 2>/dev/null |
        awk '{
            for (i=1; i<=NF; i++)
                if ($i=="src") {
                    print $(i+1)
                    exit
                }
        }'
    )"

    [[ -n "$IP" ]] && break
    sleep 1
done

SAN="DNS:$HOST,DNS:$HOST.local"

if [[ -n "$IP" ]]; then
    SAN="$SAN,IP:$IP"
fi

openssl req \
    -x509 \
    -newkey rsa:3072 \
    -sha256 \
    -days 825 \
    -nodes \
    -keyout "$KEY" \
    -out "$CERT" \
    -subj "/CN=$HOST" \
    -addext "subjectAltName=$SAN" \
    >/dev/null 2>&1

chmod 600 "$CERT" "$KEY"
